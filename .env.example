# PostgreSQL / TimescaleDB (local dev)
POSTGRES_USER=iot
POSTGRES_PASSWORD=iot_secret
POSTGRES_DB=iot_assistant

# Supabase Cloud
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=<publishable-key>   # Settings → API → Project API keys
SUPABASE_SECRET_KEY=<secret-key>             # Settings → API → Project API keys
SUPABASE_JWT_SECRET=<jwt-secret>             # Settings → API → JWT Secret

# Anthropic AI
ANTHROPIC_API_KEY=sk-ant-...

# Kimi (Moonshot) — server-side only, used by /api/ai/* endpoints
# Key must come from platform.kimi.ai (sk-kimi-...); calls go to the
# Kimi Coding endpoint (Anthropic Messages protocol), NOT api.moonshot.ai.
MOONSHOT_API_KEY=sk-kimi-...
MOONSHOT_MODEL=kimi-k2.5   # optional override; kimi-k2.5 is multimodal (text + vision)

# Backend API (FastAPI en Railway)
PUBLIC_API_URL=https://<tu-proyecto>.up.railway.app

# Frontend URL (usado por FastAPI para links de QR)
FRONTEND_URL=http://localhost:4321
